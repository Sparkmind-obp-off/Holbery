{
  "name": "holbery-master",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:docs": "node scripts/check-phase.mjs && node scripts/audit-docs.mjs",
    "test:http": "node scripts/check-http.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --branch main",
    "check": "npm run typecheck && npm test && npm run test:docs && npm run build"
  },
  "dependencies": { "hono": "4.13.13" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@hono/vite-cloudflare-pages": "0.4.3",
    "vite": "6.4.3",
    "wrangler": "4.147.0",
    "typescript": "^5.9.3",
    "@playwright/test": "^1.56.0"
  }
}
